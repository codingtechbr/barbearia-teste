rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function admin() { return request.auth != null; }
    match /servicos/{id} { allow read: if true; allow write: if admin(); }
    // Horários ocupados: público lê e cria (nunca edita) -> impede reserva dupla
    match /ocupados/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['data','hora','bloqueio']);
      allow delete: if admin();
    }
    match /agendamentos/{id} {
      allow create: if request.resource.data.status == 'pendente'
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 60
        && request.resource.data.telefone is string && request.resource.data.telefone.size() >= 10 && request.resource.data.telefone.size() <= 15
        && request.resource.data.valor is number;
      allow read, update, delete: if admin();
    }
  }
}
